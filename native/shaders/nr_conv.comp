#version 450

// One 3x3 valid convolution of a feature stack, optionally followed by ReLU:
// the single operation FFDNet is twelve of.
//
// The network is why a GPU pays here at all. Every other stage Orfeus tried to
// offload moved about as many bytes as it did arithmetic, so the host round trip
// ate the win; this one does roughly 850 thousand multiply-adds per output pixel
// of the half-resolution grid, which is four orders of magnitude more arithmetic
// per byte than the bilateral filter next door.
//
// counts:  x = input edge, y = output edge (input - 2),
//          z = input channels, w = output channels
// offsets: x = weights, y = biases, z = input planes, w = output planes
// scalars: x, y = this patch's top-left corner in the global feature map, as a
//          float because it goes negative while halo remains
// flags:   x = 1 to apply ReLU, y, z = global feature map width and height
//
// Activations outside the real feature map return to zero on the way out, which
// is what makes a tiled run agree with an untiled one: the network's
// convolutions are zero-padded, so a patch's halo must read as zero at a true
// image border rather than as whatever the neighbouring tile held. Folding it
// into the output write costs nothing, where a separate clearing pass would cost
// a barrier and a full sweep of the feature stack per layer.
//
// A workgroup covers a TILE x TILE patch of output pixels for one group of
// output channels, and stages its input through shared memory. Reading straight
// from the buffer instead measured 1.5x the CPU on an RTX 2000 Ada where the
// arithmetic alone should have been several times that: every thread fetched its
// own nine taps, so a workgroup pulled 256 x 9 values per input channel where
// the window it actually covers holds (TILE + 2)^2. Staging cuts that traffic
// sevenfold and is what turns the kernel arithmetic-bound.

#define TILE 16
#define HALO_TILE (TILE + 2)
// Input channels staged per round. Four keeps the barrier count down without
// spending much shared memory: 4 x 18 x 18 floats is a little over five KiB.
#define CHUNK 4
// Output channels one workgroup accumulates at once. Eight fits comfortably in
// registers and amortises each staged value eight ways.
#define GROUP 8u

layout(local_size_x = TILE, local_size_y = TILE) in;
layout(set = 0, binding = 0, std430) buffer Planes {
    float plane[];
};

#include "stage.glsl"

shared float staged[CHUNK][HALO_TILE][HALO_TILE];

void main() {
    uint input_edge = parameters.counts.x;
    uint output_edge = parameters.counts.y;
    uint input_channels = parameters.counts.z;
    uint output_channels = parameters.counts.w;
    uint weights = parameters.offsets.x;
    uint biases = parameters.offsets.y;
    uint source = parameters.offsets.z;
    uint target = parameters.offsets.w;

    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint first_channel = gl_WorkGroupID.z * GROUP;

    // Threads outside the output must still reach every barrier below, so this
    // is a flag rather than an early return: a workgroup that loses part of its
    // membership at a barrier has undefined behaviour.
    bool writes_output = x < output_edge && y < output_edge && first_channel < output_channels;
    uint group = min(GROUP, output_channels - min(first_channel, output_channels));

    float accumulator[GROUP];
    for (uint index = 0u; index < GROUP; ++index) {
        accumulator[index] = index < group
            ? plane[biases + first_channel + index]
            : 0.0;
    }

    // The window this workgroup stages, in patch coordinates.
    uint base_x = gl_WorkGroupID.x * uint(TILE);
    uint base_y = gl_WorkGroupID.y * uint(TILE);
    uint local = gl_LocalInvocationID.y * uint(TILE) + gl_LocalInvocationID.x;
    uint threads = uint(TILE) * uint(TILE);
    uint window = uint(HALO_TILE) * uint(HALO_TILE);
    uint last_input = input_edge - 1u;

    // Weights are [output channel][input channel][3][3], the same order the CPU
    // reference packs them in, so one channel's taps are nine contiguous floats.
    uint per_output = input_channels * 9u;
    uint input_plane = input_edge * input_edge;

    for (uint first_input = 0u; first_input < input_channels; first_input += uint(CHUNK)) {
        uint staged_count = min(uint(CHUNK), input_channels - first_input);
        barrier();
        for (uint slot = 0u; slot < staged_count; ++slot) {
            uint channel_base = source + (first_input + slot) * input_plane;
            for (uint index = local; index < window; index += threads) {
                uint row = index / uint(HALO_TILE);
                uint column = index % uint(HALO_TILE);
                // Clamped so a partial workgroup reads inside the patch. Those
                // values reach no contributing thread; they only have to be legal.
                uint sample_y = min(base_y + row, last_input);
                uint sample_x = min(base_x + column, last_input);
                staged[slot][row][column] =
                    plane[channel_base + sample_y * input_edge + sample_x];
            }
        }
        barrier();
        if (writes_output) {
            for (uint slot = 0u; slot < staged_count; ++slot) {
                uint row = gl_LocalInvocationID.y;
                uint column = gl_LocalInvocationID.x;
                float v00 = staged[slot][row][column];
                float v01 = staged[slot][row][column + 1u];
                float v02 = staged[slot][row][column + 2u];
                float v10 = staged[slot][row + 1u][column];
                float v11 = staged[slot][row + 1u][column + 1u];
                float v12 = staged[slot][row + 1u][column + 2u];
                float v20 = staged[slot][row + 2u][column];
                float v21 = staged[slot][row + 2u][column + 1u];
                float v22 = staged[slot][row + 2u][column + 2u];
                uint tap = weights + first_channel * per_output
                    + (first_input + slot) * 9u;
                for (uint index = 0u; index < group; ++index) {
                    uint w = tap + index * per_output;
                    accumulator[index] += plane[w] * v00 + plane[w + 1u] * v01
                        + plane[w + 2u] * v02
                        + plane[w + 3u] * v10 + plane[w + 4u] * v11
                        + plane[w + 5u] * v12
                        + plane[w + 6u] * v20 + plane[w + 7u] * v21
                        + plane[w + 8u] * v22;
                }
            }
        }
    }

    if (!writes_output) {
        return;
    }

    // The patch has shed one halo pixel per layer, so its corner has moved in.
    float global_x = parameters.scalars.x + float(x);
    float global_y = parameters.scalars.y + float(y);
    bool inside = global_x >= 0.0 && global_y >= 0.0
        && global_x < float(parameters.flags.y) && global_y < float(parameters.flags.z);

    uint output_plane = output_edge * output_edge;
    uint position = target + y * output_edge + x;
    bool relu = parameters.flags.x != 0u;
    for (uint index = 0u; index < group; ++index) {
        float value = inside ? accumulator[index] : 0.0;
        plane[position + (first_channel + index) * output_plane] =
            relu ? max(value, 0.0) : value;
    }
}
