#version 450

// One 3x3 valid convolution of a feature stack, optionally followed by ReLU:
// the single operation FFDNet is twelve of.
//
// The network is why a GPU pays here at all. Every other stage Orfeus tried to
// offload moved about as many bytes as it did arithmetic, so the host round trip
// ate the win; this one does roughly 850 thousand multiply-adds per output pixel
// of the half-resolution grid, which is four orders of magnitude more arithmetic
// per byte than the bilateral filter next door.
//
// counts:  x = input edge, y = output edge (input - 2),
//          z = input channels, w = output channels
// offsets: x = weights, y = biases, z = input planes, w = output planes
// scalars: x, y = this patch's top-left corner in the global feature map, as a
//          float because it goes negative while halo remains
// flags:   x = 1 to apply ReLU, y, z = global feature map width and height
//
// Activations outside the real feature map return to zero on the way out, which
// is what makes a tiled run agree with an untiled one: the network's
// convolutions are zero-padded, so a patch's halo must read as zero at a true
// image border rather than as whatever the neighbouring tile held. Folding it
// into the output write costs nothing, where a separate clearing pass would cost
// a barrier and a full sweep of the feature stack per layer.
//
// What the arrangement below is for: the first version of this shader had every
// thread load its own nine taps and its own nine weights per input channel, and
// measured 1.5x the CPU on an RTX 2000 Ada — about four percent of that card's
// arithmetic peak, so it was moving bytes, not multiplying. Staging the input in
// shared memory changed nothing, which located the traffic: nine weight loads
// bought nine multiply-adds, so weights outnumbered useful arithmetic. Each
// thread therefore computes a BLOCK x BLOCK square of output pixels, which makes
// every weight it loads feed BLOCK^2 multiply-adds, and the weights of the
// channels in flight are staged alongside the input.

// Output pixels per thread, per axis.
#define BLOCK 2
// Threads per workgroup axis; the workgroup covers TILE * BLOCK output pixels.
#define TILE 16
#define SPAN (TILE * BLOCK)
// The input window a workgroup reads: its output span plus the 3x3 overhang.
#define WINDOW (SPAN + 2)
// Input channels staged per round.
#define CHUNK 4
// Output channels one workgroup accumulates at once.
#define GROUP 8

layout(local_size_x = TILE, local_size_y = TILE) in;
layout(set = 0, binding = 0, std430) buffer Planes {
    float plane[];
};

#include "stage.glsl"

shared float staged[CHUNK][WINDOW][WINDOW];
shared float staged_weights[CHUNK][GROUP][9];

void main() {
    uint input_edge = parameters.counts.x;
    uint output_edge = parameters.counts.y;
    uint input_channels = parameters.counts.z;
    uint output_channels = parameters.counts.w;
    uint weights = parameters.offsets.x;
    uint biases = parameters.offsets.y;
    uint source = parameters.offsets.z;
    uint target = parameters.offsets.w;

    uint first_channel = gl_WorkGroupID.z * uint(GROUP);
    uint group = min(uint(GROUP), output_channels - min(first_channel, output_channels));

    // This thread's BLOCK x BLOCK output square, in patch coordinates.
    uint base_x = gl_WorkGroupID.x * uint(SPAN);
    uint base_y = gl_WorkGroupID.y * uint(SPAN);
    uint local_x = gl_LocalInvocationID.x * uint(BLOCK);
    uint local_y = gl_LocalInvocationID.y * uint(BLOCK);

    float accumulator[GROUP][BLOCK][BLOCK];
    for (int channel = 0; channel < GROUP; ++channel) {
        float bias = uint(channel) < group
            ? plane[biases + first_channel + uint(channel)]
            : 0.0;
        for (int dy = 0; dy < BLOCK; ++dy) {
            for (int dx = 0; dx < BLOCK; ++dx) {
                accumulator[channel][dy][dx] = bias;
            }
        }
    }

    uint local = gl_LocalInvocationID.y * uint(TILE) + gl_LocalInvocationID.x;
    uint threads = uint(TILE) * uint(TILE);
    uint window = uint(WINDOW) * uint(WINDOW);
    uint last_input = input_edge - 1u;
    // Weights are [output channel][input channel][3][3], the same order the CPU
    // reference packs them in, so one channel's taps are nine contiguous floats.
    uint per_output = input_channels * 9u;
    uint input_plane = input_edge * input_edge;

    for (uint first_input = 0u; first_input < input_channels; first_input += uint(CHUNK)) {
        uint staged_count = min(uint(CHUNK), input_channels - first_input);
        // Every thread reaches every barrier: a workgroup that loses part of its
        // membership at one has undefined behaviour, so nothing above returns
        // early and the out-of-range work is masked at the write instead.
        barrier();
        for (uint slot = 0u; slot < staged_count; ++slot) {
            uint channel_base = source + (first_input + slot) * input_plane;
            for (uint index = local; index < window; index += threads) {
                uint row = index / uint(WINDOW);
                uint column = index % uint(WINDOW);
                // Clamped so a partial workgroup reads inside the patch. Those
                // values reach no contributing thread; they only have to be legal.
                uint sample_y = min(base_y + row, last_input);
                uint sample_x = min(base_x + column, last_input);
                staged[slot][row][column] =
                    plane[channel_base + sample_y * input_edge + sample_x];
            }
            for (uint index = local; index < uint(GROUP) * 9u; index += threads) {
                uint channel = index / 9u;
                uint tap = index % 9u;
                staged_weights[slot][channel][tap] = channel < group
                    ? plane[weights + (first_channel + channel) * per_output
                        + (first_input + slot) * 9u + tap]
                    : 0.0;
            }
        }
        barrier();
        for (uint slot = 0u; slot < staged_count; ++slot) {
            // The square of input values this thread needs, read from shared
            // once and then reused by every output channel in the group.
            float value[BLOCK + 2][BLOCK + 2];
            for (int dy = 0; dy < BLOCK + 2; ++dy) {
                for (int dx = 0; dx < BLOCK + 2; ++dx) {
                    value[dy][dx] = staged[slot][local_y + uint(dy)][local_x + uint(dx)];
                }
            }
            for (int channel = 0; channel < GROUP; ++channel) {
                for (int dy = 0; dy < BLOCK; ++dy) {
                    for (int dx = 0; dx < BLOCK; ++dx) {
                        float sum = 0.0;
                        for (int ty = 0; ty < 3; ++ty) {
                            for (int tx = 0; tx < 3; ++tx) {
                                sum += staged_weights[slot][channel][ty * 3 + tx]
                                    * value[dy + ty][dx + tx];
                            }
                        }
                        accumulator[channel][dy][dx] += sum;
                    }
                }
            }
        }
    }

    uint output_plane = output_edge * output_edge;
    bool relu = parameters.flags.x != 0u;
    for (int dy = 0; dy < BLOCK; ++dy) {
        for (int dx = 0; dx < BLOCK; ++dx) {
            uint x = base_x + local_x + uint(dx);
            uint y = base_y + local_y + uint(dy);
            if (x >= output_edge || y >= output_edge) {
                continue;
            }
            // The patch has shed one halo pixel per layer, so its corner moved in.
            float global_x = parameters.scalars.x + float(x);
            float global_y = parameters.scalars.y + float(y);
            bool inside = global_x >= 0.0 && global_y >= 0.0
                && global_x < float(parameters.flags.y)
                && global_y < float(parameters.flags.z);
            uint position = target + y * output_edge + x;
            for (uint channel = 0u; channel < group; ++channel) {
                float result = inside ? accumulator[channel][dy][dx] : 0.0;
                plane[position + (first_channel + channel) * output_plane] =
                    relu ? max(result, 0.0) : result;
            }
        }
    }
}
