#!/bin/sh
set -eu

cd "$(dirname "$0")"

if [ "${IN_NIX_SHELL:-}" = "" ]; then
  exec nix develop --command ./orfeus-gui "$@"
fi

if [ ! -f native/target/release/liborfeus_native.so ]; then
  cargo build --release --manifest-path native/Cargo.toml
fi
if [ ! -f native/build/liborfeus_gui_preview.so ]; then
  make gui-native
fi

exec sbcl --no-userinit --non-interactive \
  --eval '(require :asdf)' \
  --eval '(asdf:load-asd (truename "orfeus.asd"))' \
  --eval '(asdf:load-system "orfeus/gui")' \
  --eval '(orfeus/gui:main)' \
  --end-toplevel-options "$@"
